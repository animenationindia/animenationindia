{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "animenationindia",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "vars": {
    "NEXT_PUBLIC_BACKEND_URL": "https://animenationindia.onrender.com",
    "NEXT_PUBLIC_SITE_URL": "https://www.animenationindia.online",
    "NEXT_PUBLIC_APP_URL": "https://www.animenationindia.online",
    "BETTER_AUTH_URL": "https://www.animenationindia.online",
    "SUPPORT_EMAIL": "animenationindia.support@gmail.com",
    "GLOBAL_EMAIL": "animenationindia.global@gmail.com",
    "TMDB_API_KEY": "2bca404e6766fc6ac7cb29ae38db027f",
    "MAL_CLIENT_ID": "f6cd787eb297c144b5cebd2ef50026c3"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
